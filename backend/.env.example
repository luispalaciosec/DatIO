# Copiar a .env. NUNCA subir .env al repositorio.

# Postgres de Supabase (usar el pooler en modo session, puerto 5432)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Auth
# Service role SOLO en el servidor (Railway): crea en Supabase Auth a los usuarios invitados
# (el enlace mágico ya no crea usuarios, #12). Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://<ref>.supabase.co
# Solo si el proyecto usa JWT legacy HS256. Si está vacío se usa JWKS (ES256/RS256).
SUPABASE_JWT_SECRET=

# Clave simétrica para pgcrypto (credencial_cifrada). Generar con: openssl rand -hex 32
CLAVE_CIFRADO=

# Secreto que Railway Cron envía en el header X-Cron-Secret
CRON_SECRET=

# Service Account de Google Cloud (JSON completo en una línea) para GA4 + Search Console
GOOGLE_SERVICE_ACCOUNT_JSON=

# Router LLM (spec/07 §5). JSON con la tabla tarea → proveedor/modelo.
LLM_MODELOS={"clasificacion":{"proveedor":"gemini","modelo":"gemini-3.1-flash-lite","batch":true},"narrativa":{"proveedor":"gemini","modelo":"gemini-3.7-flash"},"agente":{"proveedor":"deepseek","modelo":"deepseek-v4-flash"},"narrativa_regulado":{"proveedor":"together_ai","modelo":"deepseek-v4-pro"}}
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_AI_API_KEY=

# desarrollo | produccion. En produccion API_URL, FRONTEND_URL y ORIGENES_PERMITIDOS deben ser
# https:// o la API no arranca (S-6).
AMBIENTE=desarrollo
ZONA_HORARIA=America/Guayaquil
VENTANA_RESYNC_DIAS=28
# CORS: lista JSON o URLs separadas por coma
ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:5174

# Meta (PT-05 / PT-06). El token del System User no expira; va cifrado en cuentas_conectadas.
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_ID=
META_SYSTEM_USER_TOKEN=

# Export PDF (PT-11)
FRONTEND_URL=http://localhost:5174
PDF_SECRET=

# Botones "Conectar" del admin (OAuth por red)
API_URL=http://localhost:8000
META_LOGIN_CONFIG_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# TikTok for Developers (Login Kit + Display API). Sandbox hasta que TikTok apruebe la app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_BUSINESS_ID=
APIFY_TOKEN=
APIFY_USER_ID=

# --- Correo (alertas, invitaciones, reporte mensual) ---
RESEND_API_KEY=
CORREO_REMITENTE=DatIO <reportes@tudominio.com>
ALERTAS_DESTINATARIOS_EXTRA=

# --- Google Play Console (bucket de informes) ---
GOOGLE_PLAY_BUCKET=

# --- LinkedIn (versión mensual vigente de la API; opcional: scopes) ---
LINKEDIN_API_VERSION=202609
# Vacío = los de conectar.py. Lista blanca (cualquier otro detiene el arranque, N-2):
# r_organization_social, r_organization_admin, rw_organization_admin
LINKEDIN_SCOPES=

# --- CRM PrometIO (usuario de servicio) ---
PROMETIO_URL=
PROMETIO_FRONTEND_URL=
PROMETIO_SUPABASE_URL=
PROMETIO_SUPABASE_ANON_KEY=
PROMETIO_EMAIL=
PROMETIO_PASSWORD=

# --- Seguridad ---
LIMITE_PETICIONES_MIN=600

# --- Observabilidad ---
# Sentry (plan gratis). Vacío = apagado. Mismo valor en el servicio de la API y en el del cron.
SENTRY_DSN=

# --- Afinado (valores por defecto razonables) ---
META_API_VERSION=v21.0
CACHE_TTL_SEG=900
RADAR_DIAS_MINIMOS=7
