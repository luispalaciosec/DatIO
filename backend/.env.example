# Copiar a .env. NUNCA subir .env al repositorio.

# Postgres de Supabase (usar el pooler en modo session, puerto 5432)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Auth
SUPABASE_URL=https://<ref>.supabase.co
# Solo si el proyecto usa JWT legacy HS256. Si está vacío se usa JWKS (ES256/RS256).
SUPABASE_JWT_SECRET=

# Clave simétrica para pgcrypto (credencial_cifrada). Generar con: openssl rand -hex 32
CLAVE_CIFRADO=

# Secreto que Railway Cron envía en el header X-Cron-Secret
CRON_SECRET=

# Service Account de Google Cloud (JSON completo en una línea) para GA4 + Search Console
GOOGLE_SERVICE_ACCOUNT_JSON=

# Router LLM (spec/07 §5). JSON con la tabla tarea → proveedor/modelo.
LLM_MODELOS={"clasificacion":{"proveedor":"gemini","modelo":"gemini-3.1-flash-lite","batch":true},"narrativa":{"proveedor":"gemini","modelo":"gemini-3.7-flash"},"agente":{"proveedor":"deepseek","modelo":"deepseek-v4-flash"},"narrativa_regulado":{"proveedor":"together_ai","modelo":"deepseek-v4-pro"}}
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
TOGETHERAI_API_KEY=

AMBIENTE=desarrollo

# Meta (PT-05 / PT-06). El token del System User no expira; va cifrado en cuentas_conectadas.
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_ID=
META_SYSTEM_USER_TOKEN=

# Export PDF (PT-11)
FRONTEND_URL=http://localhost:5174
PDF_SECRET=

# Botones "Conectar" del admin (OAuth por red)
API_URL=http://localhost:8000
META_LOGIN_CONFIG_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
